{
  "environment": {
    "name": "Zig Development - Prozy Async Proxy",
    "network": "full"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/zig-setup.sh"
          },
          {
            "type": "command",
            "command": "echo '🚀 Prozy Development Environment Ready'"
          },
          {
            "type": "command",
            "command": "echo '📋 Custom commands: /test-coverage, /review-pr, /benchmark, /memory-audit, /feature-plan, /fix-build'"
          },
          {
            "type": "command",
            "command": "echo '🤖 Agents available: code-reviewer, performance-analyzer, memory-safety, zig-expert'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool_name == 'write' || tool_name == 'edit'",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/zig-format.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "tool_name == 'bash'",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/zig-command-validator.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash:zig build",
      "Bash:zig build test",
      "Bash:zig build test_e2e",
      "Bash:zig build -Doptimize=*",
      "Bash:zig test src/*.zig*",
      "Bash:zig fmt src/*",
      "Bash:zig fmt *.zig",
      "Bash:bun tests/*.ts",
      "Bash:git status",
      "Bash:git diff*",
      "Bash:git log*",
      "Bash:git add*",
      "Read:**/*.zig",
      "Read:**/*.md",
      "Read:**/build.zig*",
      "Read:**/*.ts",
      "Read:scripts/*",
      "Read:.envrc",
      "Read:flake.*"
    ],
    "ask": [
      "Edit:src/*.zig",
      "Write:**/*.zig",
      "Bash:git commit*",
      "Bash:git push*",
      "Bash:git rebase*",
      "Bash:git merge*",
      "Bash:git reset*",
      "Bash:git checkout*",
      "Bash:rm *",
      "Bash:mv *",
      "Edit:build.zig*",
      "Edit:**/*.md"
    ]
  }
}