{
  "proxy": {
    "listen_host": "0.0.0.0",
    "listen_port": 8080
  },
  "clusters": [
    {
      "name": "openai_backend",
      "backends": [
        {
          "host": "api.openai.com",
          "port": 443,
          "weight": 1
        }
      ],
      "strategy": "round_robin"
    }
  ],
  "routes": [
    {
      "name": "responses_api_translation",
      "match": {
        "path_prefix": "/v1/responses"
      },
      "cluster": "openai_backend",
      "cache_policy": {
        "allow": false
      },
      "timeout_policy": {
        "connect_timeout_ms": 10000,
        "request_timeout_ms": 60000,
        "response_timeout_ms": 120000
      }
    }
  ]
}
